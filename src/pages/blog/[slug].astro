---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProgressoOnda from '../../components/ProgressoOnda.astro';
import CartaoBotao from '../../components/CartaoBotao.astro';
import Destaque from '../../components/mdx/Destaque.astro';
import Comparativo from '../../components/mdx/Comparativo.astro';
import Passos from '../../components/mdx/Passos.astro';
import Checklist from '../../components/mdx/Checklist.astro';
import Citacao from '../../components/mdx/Citacao.astro';
import Numero from '../../components/mdx/Numero.astro';
import Cta from '../../components/mdx/Cta.astro';
import CalculadoraCmv from '../../components/mdx/CalculadoraCmv.astro';
import Trilha from '../../components/Trilha.astro';
import fotoRosto from '../../assets/victor-rosto.jpg';
import { formatarData, listarArtigos, tempoDeLeitura, type Artigo } from '../../lib/artigos';
import { schemaDaTrilha, schemaDoArtigo } from '../../lib/schema';
import { AUTOR, MATERIAL_POR_TEMA, buscarTema } from '../../data/site';
import Newsletter from '../../components/Newsletter.astro';

export async function getStaticPaths() {
  const artigos = await listarArtigos();
  return artigos.map((artigo) => ({ params: { slug: artigo.id }, props: { artigo, artigos } }));
}

interface Props {
  artigo: Artigo;
  artigos: Artigo[];
}

const { artigo, artigos } = Astro.props;
const { data } = artigo;
const { Content, headings } = await render(artigo);
const secoes = headings.filter((titulo) => titulo.depth === 2);
const tema = buscarTema(data.tema);
const minutos = tempoDeLeitura(artigo.body ?? '');
// O pilar do mesmo tema vem primeiro, depois os demais artigos do tema.
function relevancia(outro: Artigo) {
  if (outro.data.tema !== data.tema) return 0;
  return outro.data.tipo === 'pilar' ? 2 : 1;
}
const relacionados = artigos
  .filter((outro) => outro.id !== artigo.id)
  .sort((a, b) => relevancia(b) - relevancia(a))
  .slice(0, 3);
const componentes = { Destaque, Comparativo, Passos, Checklist, Citacao, Numero, Cta, CalculadoraCmv };
const trilha = [
  { nome: 'Blog', href: '/blog' },
  { nome: tema?.nome ?? '', href: `/blog/tema/${data.tema}` },
  { nome: data.titulo },
];
const tituloComMarca = `${data.titulo} | GASS`;
const tituloDaPagina = data.tituloSeo || (tituloComMarca.length <= 60 ? tituloComMarca : data.titulo);
---

<Base
  titulo={tituloDaPagina}
  descricao={data.resumo}
  tipo="article"
  imagem={`/blog/og/${artigo.id}.png`}
  versaoMarkdown={`/blog/${artigo.id}.md`}
  schema={[...schemaDoArtigo(artigo), schemaDaTrilha(trilha)]}
>
  <ProgressoOnda slot="topo" />
  <article class="mx-auto max-w-7xl px-4 pt-6 sm:px-8">
    <Trilha itens={trilha} />

    <header class="mt-8 max-w-4xl">
      <h1 class="titulo text-[2.5rem] leading-[1.1] sm:text-6xl">{data.titulo}</h1>
      <p class="mt-6 text-[0.9375rem]">
        Publicado em {formatarData(data.publicadoEm)}{
          data.atualizadoEm && `, atualizado em ${formatarData(data.atualizadoEm)}`
        }. Leitura de {minutos} min.
      </p>
      {data.rascunho && <p class="rotulo mt-2">Rascunho: só aparece no seu computador</p>}
    </header>

    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,44rem)_16rem] lg:justify-between">
      <div class="min-w-0">
        <section class="superficie p-6 sm:p-8" aria-labelledby="resumo-30">
          <h2 id="resumo-30" class="font-bold text-tinta">Resumo em 30 segundos</h2>
          <p class="mt-2 text-lg leading-relaxed">{data.resposta}</p>
        </section>

        <details class="mt-8 border-y border-linha py-3 lg:hidden">
          <summary class="cursor-pointer font-bold text-tinta">Neste artigo</summary>
          <ul class="mt-3 space-y-2 text-[0.9375rem]">
            {secoes.map((secao) => <li><a href={`#${secao.slug}`}>{secao.text}</a></li>)}
          </ul>
        </details>

        <div class="prosa mt-10">
          <Content components={componentes} />
        </div>

        {
          data.faq.length > 0 && (
            <section class="mt-16" aria-labelledby="faq">
              <h2 id="faq" class="titulo text-3xl">
                Perguntas frequentes
              </h2>
              <div class="mt-5 border-t border-linha">
                {data.faq.map((item) => (
                  <details class="border-b border-linha py-4">
                    <summary class="cursor-pointer text-lg text-tinta">{item.pergunta}</summary>
                    <p class="mt-3">{item.resposta}</p>
                  </details>
                ))}
              </div>
            </section>
          )
        }

        <Cta texto={data.cta.texto} mensagem={data.cta.mensagem} />

        <Newsletter material={data.material === 'padrao' ? MATERIAL_POR_TEMA[data.tema] : data.material} />

        <section class="mt-14 flex flex-col gap-5 border-t border-linha pt-8 sm:flex-row" aria-label="Sobre o autor">
          <Image
            src={fotoRosto}
            alt="Rosto de Victor Macambira"
            width={96}
            height={96}
            class="size-24 shrink-0 rounded-full object-cover"
          />
          <div>
            <p class="titulo text-xl">
              <a href="/autor/victor-macambira" class="hover:text-coral-texto">{AUTOR.nome}</a>
            </p>
            <p class="text-[0.9375rem] text-tinta">{AUTOR.cargo}</p>
            <p class="mt-2 text-[0.9375rem]">{AUTOR.bio}</p>
          </div>
        </section>
      </div>

      <aside class="hidden lg:block" aria-label="Sumário">
        <nav class="sticky top-8 max-h-[calc(100vh-4rem)] overflow-y-auto pr-2">
          <p class="font-bold text-tinta">Neste artigo</p>
          <ul class="mt-3 space-y-3 border-l border-linha pl-4 text-sm leading-snug">
            {
              secoes.map((secao) => (
                <li>
                  <a href={`#${secao.slug}`} class="hover:text-coral-texto">
                    {secao.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>
    </div>

    {
      relacionados.length > 0 && (
        <section class="mt-20" aria-labelledby="relacionados">
          <h2 id="relacionados" class="titulo text-3xl">
            Continue lendo
          </h2>
          <ul class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {relacionados.map((outro) => (
              <li>
                <CartaoBotao href={`/blog/${outro.id}`} titulo={outro.data.titulo} tamanho="pequeno" />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>
