---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import OndaGass from '../../components/OndaGass.astro';
import CartaoBotao from '../../components/CartaoBotao.astro';
import Newsletter from '../../components/Newsletter.astro';
import fotoPalco from '../../assets/victor-palco.jpg';
import { listarArtigos } from '../../lib/artigos';
import { AUTOR, NUMEROS, SITE, TEMAS } from '../../data/site';

const artigos = await listarArtigos();
const destaque = artigos.find((artigo) => artigo.data.tipo === 'pilar') ?? artigos[0];
const comeceAqui = artigos.filter((artigo) => artigo.id !== destaque?.id).slice(0, 3);
const temasComArtigo = new Set(artigos.map((artigo) => artigo.data.tema));
---

<Base titulo="Blog de gestão para donos de PMEs | GASS" descricao={SITE.descricao}>
  <section class="relative overflow-hidden">
    <OndaGass class="absolute -right-10 top-0 hidden h-[115%] w-auto lg:block xl:right-8" />
    <div class="relative mx-auto max-w-7xl px-4 pb-20 pt-10 sm:px-8 lg:pb-28 lg:pt-16">
      <h1 class="max-w-xl text-[0.9375rem]">Blog de gestão para donos de pequenas e médias empresas</h1>
      {
        destaque && (
          <div class="mt-10 max-w-3xl lg:mt-16">
            <h2 class="titulo text-[3.25rem] leading-[1.05] sm:text-7xl lg:text-[5.5rem]">
              <a href={`/blog/${destaque.id}`} class="hover:text-coral-texto">
                {destaque.data.pergunta}
              </a>
            </h2>
            <p class="mt-8 max-w-2xl text-lg leading-relaxed sm:text-xl">{destaque.data.resposta}</p>
            <a href={`/blog/${destaque.id}`} class="botao mt-7">
              Ler o guia completo
            </a>
          </div>
        )
      }
    </div>
  </section>

  {
    comeceAqui.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 sm:px-8" aria-labelledby="comece">
        <h2 id="comece" class="titulo text-3xl sm:text-4xl">
          Comece por aqui
        </h2>
        <ul class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {comeceAqui.map((artigo) => (
            <li>
              <CartaoBotao href={`/blog/${artigo.id}`} titulo={artigo.data.titulo} texto={artigo.data.resumo} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section id="temas" class="mx-auto mt-24 max-w-7xl px-4 sm:px-8" aria-labelledby="titulo-temas">
    <h2 id="titulo-temas" class="titulo text-3xl sm:text-4xl">O que está travando a sua empresa?</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        TEMAS.map((tema) =>
          temasComArtigo.has(tema.id) ? (
            <li>
              <CartaoBotao href={`/blog/tema/${tema.id}`} titulo={tema.nome} texto={tema.pergunta} tamanho="pequeno" />
            </li>
          ) : (
            <li class="p-6">
              <p class="titulo text-xl leading-snug">{tema.nome}</p>
              <p class="mt-2 text-[0.9375rem] leading-normal">{tema.pergunta}</p>
            </li>
          ),
        )
      }
    </ul>
  </section>

  <section class="mt-24 bg-noite text-papel" aria-labelledby="quem-escreve">
    <div class="mx-auto grid max-w-7xl md:grid-cols-[2fr_3fr]">
      <Image
        src={fotoPalco}
        alt="Victor Macambira falando ao microfone no palco do iFood Move"
        widths={[480, 800, 1100]}
        sizes="(min-width: 768px) 40vw, 100vw"
        class="h-80 w-full object-cover object-[50%_20%] md:h-full"
      />
      <div class="px-4 py-14 sm:px-8 lg:px-16 lg:py-20">
        <h2 id="quem-escreve" class="font-titulo text-3xl leading-tight text-papel sm:text-4xl">
          Quem escreve já esteve do seu lado do balcão
        </h2>
        <p class="mt-5 max-w-xl text-[#d8d2d2]">{AUTOR.nome}. {AUTOR.bio}</p>
        <dl class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
          {
            NUMEROS.map((numero) => (
              <div class="flex flex-col-reverse">
                <dt class="mt-1 text-[0.9375rem] leading-snug text-[#d8d2d2]">{numero.rotulo}</dt>
                <dd class="font-titulo text-5xl text-coral">{numero.valor}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <div class="mx-auto mt-24 max-w-3xl px-4 sm:px-8">
    <Newsletter material="rotina" />
  </div>
</Base>
