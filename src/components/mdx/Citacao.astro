---
interface Props {
  autor: string;
  cargo?: string;
}

const { autor, cargo } = Astro.props;
---

<figure class="my-10">
  <blockquote class="titulo text-[1.75rem] leading-snug"><slot /></blockquote>
  <figcaption class="mt-3 text-[0.9375rem]">
    <span class="font-bold text-tinta">{autor}</span>
    {cargo && <span>, {cargo}</span>}
  </figcaption>
</figure>
