---
const campos = [
  { id: 'estoque-inicial', rotulo: 'Estoque inicial (R$)' },
  { id: 'compras', rotulo: 'Compras do período (R$)' },
  { id: 'estoque-final', rotulo: 'Estoque final (R$)' },
  { id: 'faturamento', rotulo: 'Faturamento líquido (R$)' },
];
---

<form id="calculadora-cmv" class="superficie my-10 p-5 sm:p-7" novalidate>
  <h3 class="titulo !mt-0 text-[1.375rem]">Calcule o seu CMV</h3>
  <div class="mt-5 grid gap-4 sm:grid-cols-2">
    {
      campos.map((campo) => (
        <div>
          <label for={campo.id} class="block text-[0.9375rem] leading-snug text-tinta">
            {campo.rotulo}
          </label>
          <input
            id={campo.id}
            name={campo.id}
            type="number"
            inputmode="decimal"
            min="0"
            step="0.01"
            class="mt-1.5 w-full rounded-sm border border-apoio bg-fundo px-3 py-2 text-tinta"
          />
        </div>
      ))
    }
  </div>
  <p class="mt-6 text-tinta" aria-live="polite">
    <output id="resultado-cmv">Preencha os quatro campos para ver o resultado.</output>
  </p>
</form>

<script>
  const form = document.getElementById('calculadora-cmv') as HTMLFormElement | null;
  const saida = document.getElementById('resultado-cmv');
  const moeda = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
  const percentual = new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 1 });

  form?.addEventListener('submit', (evento) => evento.preventDefault());
  form?.addEventListener('input', () => {
    if (!saida) return;
    const dados = new FormData(form);
    const valores = ['estoque-inicial', 'compras', 'estoque-final', 'faturamento'].map((nome) =>
      String(dados.get(nome) ?? ''),
    );
    if (valores.some((valor) => valor === '')) {
      saida.textContent = 'Preencha os quatro campos para ver o resultado.';
      return;
    }
    const [inicial, compras, final, faturamento] = valores.map(Number);
    if (faturamento <= 0) {
      saida.textContent = 'Informe um faturamento maior que zero.';
      return;
    }
    const cmv = inicial + compras - final;
    saida.textContent = `CMV de ${moeda.format(cmv)}, o que representa ${percentual.format((cmv / faturamento) * 100)}% do faturamento.`;
  });
</script>
