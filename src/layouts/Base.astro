---
import '../styles/global.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import { SITE } from '../data/site';
import { schemaDoSite } from '../lib/schema';

interface Props {
  titulo: string;
  descricao: string;
  imagem?: string;
  tipo?: 'website' | 'article';
  semIndice?: boolean;
  schema?: Record<string, unknown>[];
  versaoMarkdown?: string;
  semWhatsApp?: boolean;
}

const {
  titulo,
  descricao,
  imagem = '/blog/og/padrao.png',
  tipo = 'website',
  semIndice = false,
  schema = [],
  versaoMarkdown,
  semWhatsApp = false,
} = Astro.props;
const canonica = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site);
const imagemSocial = new URL(imagem, Astro.site);
const dadosEstruturados = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [...schemaDoSite(), ...schema],
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    {semIndice && <meta name="robots" content="noindex, follow" />}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagemSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={imagemSocial} />
    <link rel="alternate" type="application/rss+xml" title={SITE.nome} href="/blog/rss.xml" />
    {versaoMarkdown && <link rel="alternate" type="text/markdown" href={versaoMarkdown} />}
    <link rel="icon" type="image/png" href="/blog/logo-gass.png" />
    <script is:inline type="application/ld+json" set:html={dadosEstruturados} />
    <script is:inline>
      try {
        const salvo = localStorage.getItem('tema');
        if (salvo) document.documentElement.dataset.tema = salvo;
      } catch {}
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-fundo focus:px-4 focus:py-2"
    >
      Ir para o conteúdo
    </a>
    <slot name="topo" />
    <Cabecalho />
    <main id="conteudo" class="flex-1">
      <slot />
    </main>
    <Rodape />
    {!semWhatsApp && <BotaoWhatsApp />}
    <script>
      import { registrarEvento } from '../lib/eventos';

      // Registra os cliques que indicam interesse comercial, sem precisar marcar cada botão.
      document.addEventListener('click', (evento) => {
        const link = (evento.target as Element).closest('a');
        if (!link) return;
        const destino = link.getAttribute('href') ?? '';
        if (destino.includes('wa.me')) registrarEvento('whatsapp_clique');
        else if (destino.startsWith('/diagnostico')) registrarEvento('diagnostico_clique');
        else if (destino.startsWith('/blog/materiais/')) registrarEvento('material_download', { arquivo: destino });
      });
    </script>
  </body>
</html>
